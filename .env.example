# Teldrive server URL
TELDRIVE_URL="http://your-teldrive-server:port"

# Your Teldrive access token
TELDRIVE_TOKEN="your-jwt-token-here"

# Enable or disable the upload page (true/false)
# When set to false, the upload link will be hidden from the navigation
# and the /upload endpoint will return a 404 error
ENABLE_UPLOAD_PAGE=true

# Buffer size for file streaming in KB (default: 256KB)
# Larger values may improve performance for fast connections
# Recommended values: 128, 256, 512, 1024
STREAM_BUFFER_SIZE=256

# Log connection errors like "broken pipe" (true/false)
# Set to false to reduce log noise from download managers like aria2c
# These errors are normal when clients disconnect early
LOG_CONNECTION_ERRORS=false
